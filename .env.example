# Copy this file to .env and fill in real values before running
# `docker compose up`. .env is gitignored - never commit real secrets.

# --- Critical: database credentials (used by database + backend) ---
POSTGRES_USER=conduit
POSTGRES_PASSWORD=changeme
POSTGRES_DB=conduit

# --- Critical: Django JWT signing / session secret ---
# Generate a real one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-a-long-random-string

# --- Non-critical: leave commented out to use the defaults baked into the
# Dockerfiles. Uncomment and change only if you need something different. ---
# BACKEND_PORT=5000
# BACKEND_HOST_PORT=5000
# GUNICORN_WORKERS=3
# DEBUG=false
# ALLOWED_HOSTS=*
# CORS_ORIGINS=*
# FRONTEND_INTERNAL_PORT=80
