# Copy this file to .env and fill in real values before running
# `docker compose up`. .env is gitignored - never commit real secrets.
#
# On the cloud VM this file is not used: the deployment workflow
# (.github/workflows/deployment.yaml) writes .env from the repository secrets
# on every deploy.

# --- Critical: database credentials (used by database + backend) ---
POSTGRES_USER=conduit
POSTGRES_PASSWORD=changeme
POSTGRES_DB=conduit

# --- Critical: Django JWT signing / session secret ---
# Generate a real one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-a-long-random-string

# --- Non-critical: leave commented out to use the defaults baked into the
# Dockerfiles and docker-compose.yaml. Uncomment and change only if you need
# something different. ---

# Container images to run. The deployment workflow overrides these with the
# registry namespace and the commit SHA of the build it just pushed.
# IMAGE_REGISTRY=ghcr.io/mshaninah
# IMAGE_TAG=latest

# Ports
# FRONTEND_HOST_PORT=8282
# FRONTEND_INTERNAL_PORT=80
# BACKEND_PORT=5000
# BACKEND_HOST_PORT=5000

# Backend runtime
# GUNICORN_WORKERS=3
# DEBUG=false
# ALLOWED_HOSTS=*
# CORS_ORIGINS=*

# Log rotation for the json-file logging driver
# LOG_MAX_SIZE=10m
# LOG_MAX_FILE=5
